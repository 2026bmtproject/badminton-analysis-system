# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
desktop-out/
electron-dist/
*.log
*.tmp
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.local/
.ipynb_checkpoints/

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Environment / secrets ----
.env
.env.*
config.yaml

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Matches output data (generated, never in repo) ----
# A match dir matches/{match}/ is a project path: input/ holds the raw video,
# stages/ holds every stage's generated output. None of it is committed.
matches/*
!matches/.gitkeep

# ---- Data / media artifacts ----
# Source JSON/CSV, contracts, and fixtures remain visible to Git. Match outputs,
# UI publications, and task records are excluded by their directories above.
*.mp4
*.avi
*.mkv
*.mov
*.wav
*.mp3
*.npy
*.npz

# ---- ML model weights / checkpoints ----
*.pt
*.pth
*.onnx
*.ckpt
*.h5
*.pb
*.tflite

# ---- Keep tracked config/lock files that would otherwise match above ----
!config.yaml.example
!uv.lock
!models/yamnet_mean_lr_v1/model.npz
!models/yamnet_mean_lr_v1/metadata.json

# ---- Experiment bundle (experiments/) ----
# Ground truth, labelling/eval scripts and result tables are published so the
# numbers in the report can be reproduced. Videos stay out (see dataset/).
!experiments/**/*.csv
!experiments/**/*.json
