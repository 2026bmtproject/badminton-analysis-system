{
  "$defs": {
    "audio_highlight": {
      "$defs": {
        "AudioSignalRecord": {
          "additionalProperties": true,
          "properties": {
            "cheer_confidence": {
              "maximum": 1,
              "minimum": 0,
              "title": "Cheer Confidence",
              "type": "number"
            },
            "cheer_intensity": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cheer Intensity"
            },
            "n_cheer_windows": {
              "minimum": 0,
              "title": "N Cheer Windows",
              "type": "integer"
            },
            "segment_index": {
              "minimum": 0,
              "title": "Segment Index",
              "type": "integer"
            }
          },
          "required": [
            "segment_index",
            "cheer_confidence",
            "n_cheer_windows"
          ],
          "title": "AudioSignalRecord",
          "type": "object"
        },
        "AudioWindowRecord": {
          "additionalProperties": true,
          "properties": {
            "cheer_probability": {
              "maximum": 1,
              "minimum": 0,
              "title": "Cheer Probability",
              "type": "number"
            },
            "end_sec": {
              "minimum": 0,
              "title": "End Sec",
              "type": "number"
            },
            "segment_index": {
              "minimum": 0,
              "title": "Segment Index",
              "type": "integer"
            },
            "start_sec": {
              "minimum": 0,
              "title": "Start Sec",
              "type": "number"
            }
          },
          "required": [
            "segment_index",
            "start_sec",
            "end_sec",
            "cheer_probability"
          ],
          "title": "AudioWindowRecord",
          "type": "object"
        }
      },
      "additionalProperties": true,
      "properties": {
        "signals": {
          "items": {
            "$ref": "#/$defs/AudioSignalRecord"
          },
          "title": "Signals",
          "type": "array"
        },
        "windows": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/AudioWindowRecord"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Windows"
        }
      },
      "required": [
        "signals"
      ],
      "title": "AudioArtifact",
      "type": "object"
    },
    "commentary": {
      "$defs": {
        "CommentaryEvent": {
          "additionalProperties": false,
          "properties": {
            "frame": {
              "minimum": 0,
              "title": "Frame",
              "type": "integer"
            },
            "player": {
              "enum": [
                "a",
                "b"
              ],
              "title": "Player",
              "type": "string"
            },
            "segment_index": {
              "minimum": 0,
              "title": "Segment Index",
              "type": "integer"
            },
            "source_fact_ids": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Source Fact Ids",
              "type": "array"
            },
            "stroke_index": {
              "minimum": 0,
              "title": "Stroke Index",
              "type": "integer"
            },
            "text": {
              "minLength": 1,
              "title": "Text",
              "type": "string"
            },
            "time_sec": {
              "minimum": 0,
              "title": "Time Sec",
              "type": "number"
            }
          },
          "required": [
            "segment_index",
            "text",
            "source_fact_ids",
            "stroke_index",
            "frame",
            "time_sec",
            "player"
          ],
          "title": "CommentaryEvent",
          "type": "object"
        },
        "CommentaryRally": {
          "additionalProperties": false,
          "properties": {
            "events": {
              "items": {
                "$ref": "#/$defs/CommentaryEvent"
              },
              "title": "Events",
              "type": "array"
            },
            "segment_index": {
              "minimum": 0,
              "title": "Segment Index",
              "type": "integer"
            },
            "summary": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CommentarySummary"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "segment_index",
            "events",
            "summary"
          ],
          "title": "CommentaryRally",
          "type": "object"
        },
        "CommentarySummary": {
          "additionalProperties": false,
          "properties": {
            "segment_index": {
              "minimum": 0,
              "title": "Segment Index",
              "type": "integer"
            },
            "source_fact_ids": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Source Fact Ids",
              "type": "array"
            },
            "text": {
              "minLength": 1,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "segment_index",
            "text",
            "source_fact_ids"
          ],
          "title": "CommentarySummary",
          "type": "object"
        },
        "UnsupportedCommentary": {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "minLength": 1,
              "title": "Reason",
              "type": "string"
            },
            "segment_index": {
              "minimum": 0,
              "title": "Segment Index",
              "type": "integer"
            }
          },
          "required": [
            "segment_index",
            "reason"
          ],
          "title": "UnsupportedCommentary",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "rallies": {
          "items": {
            "$ref": "#/$defs/CommentaryRally"
          },
          "title": "Rallies",
          "type": "array"
        },
        "runtime": {
          "additionalProperties": true,
          "title": "Runtime",
          "type": "object"
        },
        "schema_version": {
          "const": "commentary-rallies-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "unsupported_segments": {
          "items": {
            "$ref": "#/$defs/UnsupportedCommentary"
          },
          "title": "Unsupported Segments",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "rallies",
        "unsupported_segments",
        "diagnostics",
        "runtime"
      ],
      "title": "CommentaryArtifact",
      "type": "object"
    },
