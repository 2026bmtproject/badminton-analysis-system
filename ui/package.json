{
  "name": "badminton-review-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "import:match": "node --require ./scripts/node-userinfo-shim.cjs --import tsx scripts/import-match.ts",
    "preview": "vite preview --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "generate:data": "node --require ./scripts/node-userinfo-shim.cjs --import tsx scripts/generate-data.ts",
    "generate:video": "node --require ./scripts/node-userinfo-shim.cjs --import tsx scripts/generate-video.ts",
    "demo": "npm run generate:data && npm run generate:video",
    "build": "npm run generate:data && vue-tsc --noEmit && vite build",
    "test": "node --require ./scripts/node-userinfo-shim.cjs --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "vue": "^3.5.22",
    "vue-router": "^5.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "ffprobe-static": "^3.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.0"
  }
}
