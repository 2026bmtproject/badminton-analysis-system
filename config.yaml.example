# 範例設定。使用：cp config.yaml.example config.yaml 後填入自己的值。
# 真正的 config.yaml 含 API key 等機密，已被 .gitignore 忽略，勿提交。

# Gemini API key（score_recognition/commentary 階段用；申請：https://aistudio.google.com/app/api-keys）
# 環境變數 GEMINI_API_KEY 若有設定會優先於此值。
gemini_api_key: ""

# Production commentary generation. COMMENTARY_GEMINI_MODEL overrides model.
# The four budgets are separate because each structured response has a different shape.
commentary:
  model: "gemini-3.8-flash"
  timeout_seconds: 30
  tactical_generator_max_output_tokens: 8192
  tactical_reviewer_max_output_tokens: 4096
  commentator_max_output_tokens: 8192
  commentary_reviewer_max_output_tokens: 4096
